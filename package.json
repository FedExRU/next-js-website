{
  "name": "test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "commit": "cz",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noemit && pnpm run fsd-check-backend && pnpm run fsd-check-frontend && eslint",
    "lint:fix": "tsc --noemit && pnpm run fsd-check-backend && pnpm run fsd-check-frontend && eslint --fix",
    "prepare": "husky install",
    "pa11y": "pa11y-ci --config .pa11yci.json",
    "find:unused": "next-unused",
    "preinstall": "npx only-allow pnpm",
    "fsd-check-frontend": "steiger ./src/frontend",
    "fsd-check-backend": "steiger ./src/backend",
    "migrate:latest": "npx knex migrate:latest --knexfile ./src/backend/shared/db/knexfile.ts"
  },
  "engines": {
    "node": "23",
    "pnpm": "10"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@tanstack/react-query": "5.90.12",
    "@types/react-slick": "^0.23.13",
    "argon2": "0.44.0",
    "axios": "1.13.2",
    "css-mediaquery": "0.1.2",
    "dompurify": "^3.3.1",
    "formik": "^2.4.9",
    "knex": "3.1.0",
    "next": "16.0.10",
    "pg": "8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intersection-observer": "10.0.0",
    "react-slick": "0.31.0",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.34.5",
    "slick-carousel": "1.8.1",
    "sprintf-js": "1.1.3",
    "ua-parser-js": "^2.0.7",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@next/bundle-analyzer": "16.0.10",
    "@types/css-mediaquery": "0.1.4",
    "@types/node": "^25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@types/sprintf-js": "1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@typescript-eslint/typescript-estree": "^8.50.0",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.5.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.0.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "steiger": "^0.5.11",
    "typescript": "^5.9.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,json,js}": [
      "pnpm run lint:fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
